  "stemmaNote": "The Homeric tradition is not a clean family tree: the poems began as oral poetry and copies were constantly compared with each other. The diagram is a simplified overview; dashed links are traditional or disputed.",
  "nodes": [
    {
      "id": "omega",
      "kind": "lost",
      "row": 0,
      "x": 0.5,
      "label": "ω",
      "title": "The lost original",
      "date": "c. 8th–7th century BCE",
      "note": "The Iliad was composed in Greek hexameter verse, probably in Ionia, drawing on a long tradition of oral poetry. No original copy survives, and whether a single original ever existed is itself debated."
    },
    {
      "id": "peisistratus",
      "kind": "recension",
      "row": 1,
      "x": 0.5,
      "label": "Athens",
      "title": "Peisistratean recension",
      "date": "6th century BCE",
      "parents": [
        {
          "id": "omega",
          "approx": true
        }
      ],
      "note": "According to ancient tradition, the poems were first written down or standardised in Athens under Peisistratus. Many scholars doubt this account, so the link is shown dashed."
    },
    {
      "id": "alexandria",
      "kind": "recension",
      "row": 2,
      "x": 0.5,
      "label": "Alexandria",
      "title": "Alexandrian scholarship",
      "date": "c. 280–150 BCE",
      "parents": [
        {
          "id": "peisistratus",
          "approx": true
        }
      ],
      "note": "Scholars at the Library of Alexandria (Zenodotus, Aristophanes of Byzantium and Aristarchus) compared copies, marked lines they judged spurious and are credited with dividing the poem into 24 books."
    },
    {
      "id": "papyri",
      "kind": "manuscript",
      "row": 3,
      "x": 0.12,
      "label": "Papyri",
      "title": "Papyrus fragments",
      "date": "3rd century BCE – 7th century CE",
      "parents": [
        {
          "id": "alexandria"
        }
      ],
      "note": "Many hundreds of papyrus fragments, mostly from Egypt. The earliest contain extra lines not found in later copies."
    },
    {
      "id": "medieval",
      "kind": "manuscript",
      "row": 3,
      "x": 0.55,
      "label": "Byzantine copies",
      "title": "Medieval manuscripts",
      "date": "from the 9th century CE",
      "parents": [
        {
          "id": "alexandria"
        }
      ],
      "note": "The complete text of the Iliad survives through manuscripts copied in the Byzantine world from the 9th century onward."
    },
    {
      "id": "venetusA",
      "kind": "manuscript",
      "row": 4,
      "x": 0.25,
      "label": "Venetus A",
      "title": "Venetus A (Marcianus Graecus 454)",
      "date": "10th century",
      "place": "Venice, Biblioteca Nazionale Marciana",
      "parents": [
        {
          "id": "medieval"
        }
      ],
      "note": "The oldest complete manuscript of the Iliad. Its margins preserve scholia (ancient commentary) that report the readings of the Alexandrian scholars."
    },
